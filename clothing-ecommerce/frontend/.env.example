# Public URL of the backend API (used by the browser)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional: URL the Next.js server uses to reach the API (e.g. http://backend:5000 inside Docker).
# Defaults to NEXT_PUBLIC_API_URL.
API_URL_INTERNAL=

# Public URL of this storefront (used for SEO / share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
