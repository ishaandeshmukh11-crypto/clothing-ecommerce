# ---- Server ----
PORT=5000
NODE_ENV=development

# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/clothing_store

# Long random string used to sign login tokens. CHANGE THIS in production.
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=30d

# Storefront URL(s) allowed to call the API (comma separated). Use * only in development.
CLIENT_URL=http://localhost:3000

# Public URL of this API, used to build image URLs for local uploads
PUBLIC_URL=http://localhost:5000

# ---- First admin account (created by `npm run seed`) ----
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@store.com
ADMIN_PASSWORD=Admin@123

# ---- Optional: Cloudinary image hosting (recommended in production) ----
# If left empty, images are saved to the local /uploads folder.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Optional: Razorpay online payments ----
# If left empty, checkout offers Cash on Delivery and WhatsApp order only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Optional: WhatsApp Business Cloud API (auto-reply bot + order alerts) ----
# From Meta Developer Console → your app → WhatsApp → API Setup.
# If left empty, the website still has the chatbot and "Chat on WhatsApp" buttons (wa.me links).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=choose_any_secret_word
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# Public storefront URL used in links the bot sends (defaults to the first CLIENT_URL)
STORE_URL=http://localhost:3000

# ---- Optional: AI answers for the chatbot (Anthropic Claude) ----
# Without a key the bot still answers from the trained FAQ, live products, orders and store settings.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ---- Seller mobile app: push notifications for every order ----
# Generate once with:  npm run vapid   (paste both keys here)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@store.com

# ---- Optional: Instagram (DM auto-replies + feed on website) ----
# Instagram professional account connected to the same Meta app as WhatsApp.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# ---- Advanced: override the Meta Graph API base (testing only) ----
GRAPH_API_BASE=
